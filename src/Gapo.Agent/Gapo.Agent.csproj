<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Gapo.Agent</RootNamespace>
    <AssemblyName>Gapo.Agent</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gapo.Core\Gapo.Core.csproj" />
    <ProjectReference Include="..\Gapo.Windows\Gapo.Windows.csproj" />
    <ProjectReference Include="..\..\fixture\Gapo.Sandbox.Contract\Gapo.Sandbox.Contract.csproj" />
  </ItemGroup>
</Project>
