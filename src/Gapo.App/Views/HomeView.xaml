<UserControl
    x:Class="Gapo.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="16" MaxWidth="960">
    <Border Style="{StaticResource GapoCardStyle}">
      <StackPanel Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock x:Name="GameTitle" Text="No game is running" Style="{StaticResource GapoTitleStyle}" />
          <TextBlock x:Name="StatusDetail" Style="{StaticResource GapoBodyStyle}" Text="Start a game and GAPO will find out what limits it on this PC. It then changes one setting at a time, measures the result on the same scene, and keeps only what demonstrably helps." />
        </StackPanel>

        <Grid x:Name="LivePanel" Visibility="Collapsed" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Text="Frames per second" Style="{StaticResource GapoSectionLabelStyle}" />
              <TextBlock x:Name="FpsValue" Text="–" Style="{StaticResource GapoValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Frame time (ms)" Style="{StaticResource GapoSectionLabelStyle}" />
              <TextBlock x:Name="FrameTimeValue" Text="–" Style="{StaticResource GapoValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="Frame work (ms)" Style="{StaticResource GapoSectionLabelStyle}" />
              <TextBlock x:Name="FrameWorkValue" Text="–" Style="{StaticResource GapoValueStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="2">
              <TextBlock Text="Stutters per minute" Style="{StaticResource GapoSectionLabelStyle}" />
              <TextBlock x:Name="StutterValue" Text="–" Style="{StaticResource GapoValueStyle}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Frame time, last 10 seconds" Style="{StaticResource GapoSectionLabelStyle}" />
            <Border BorderBrush="{ThemeResource GapoBorderBrush}" BorderThickness="1" CornerRadius="4">
              <Canvas x:Name="ChartArea" Height="120" SizeChanged="OnChartSizeChanged" AutomationProperties.Name="Frame time chart">
                <Line x:Name="SixtyGuide" Stroke="{ThemeResource GapoBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" />
                <Line x:Name="ThirtyGuide" Stroke="{ThemeResource GapoBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" />
                <Polyline x:Name="FrameLine" Stroke="{ThemeResource GapoAccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
              </Canvas>
            </Border>
            <TextBlock x:Name="LoadLine" Style="{StaticResource GapoSecondaryStyle}" />
          </StackPanel>
        </Grid>

        <StackPanel x:Name="ControlsPanel" Spacing="12" Visibility="Collapsed">
          <StackPanel Spacing="4">
            <TextBlock Text="Goal" Style="{StaticResource GapoSectionLabelStyle}" />
            <SelectorBar x:Name="GoalSelector" SelectionChanged="OnGoalChanged">
              <SelectorBarItem Text="Balanced" />
              <SelectorBarItem Text="Maximum FPS" />
              <SelectorBarItem Text="Quality" />
              <SelectorBarItem Text="Smoothness" />
            </SelectorBar>
            <TextBlock x:Name="GoalDescription" Style="{StaticResource GapoSecondaryStyle}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OptimiseButton" Content="Optimise" Style="{StaticResource AccentButtonStyle}" Click="OnOptimiseClicked" />
            <Button x:Name="StopButton" Content="Stop" Visibility="Collapsed" Click="OnStopClicked" />
            <Button x:Name="RevertButton" Content="Revert all" Click="OnRevertClicked" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource GapoSecondaryStyle}" Text="GAPO never injects into games, never closes programs and can put every setting back." />
  </StackPanel>
</UserControl>
