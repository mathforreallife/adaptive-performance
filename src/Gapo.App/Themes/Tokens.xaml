<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="GapoBackgroundBrush" Color="#F5F6F8" />
      <SolidColorBrush x:Key="GapoSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GapoBorderBrush" Color="#E2E4E9" />
      <SolidColorBrush x:Key="GapoTextBrush" Color="#16181D" />
      <SolidColorBrush x:Key="GapoTextSecondaryBrush" Color="#5B6170" />
      <SolidColorBrush x:Key="GapoTextTertiaryBrush" Color="#6F7582" />
      <SolidColorBrush x:Key="GapoAccentBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="GapoOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GapoGoodBrush" Color="#15803D" />
      <SolidColorBrush x:Key="GapoWarnBrush" Color="#B45309" />
      <SolidColorBrush x:Key="GapoBadBrush" Color="#B91C1C" />
      <SolidColorBrush x:Key="GapoGoodTintBrush" Color="#15803D" Opacity="0.10" />
      <SolidColorBrush x:Key="GapoWarnTintBrush" Color="#B45309" Opacity="0.10" />
      <SolidColorBrush x:Key="GapoBadTintBrush" Color="#B91C1C" Opacity="0.10" />
      <SolidColorBrush x:Key="GapoStageSimulationBrush" Color="#C2417A" />
      <SolidColorBrush x:Key="GapoStageRenderingBrush" Color="#1D7FB5" />
      <SolidColorBrush x:Key="GapoStagePresentBrush" Color="#6D5BD0" />
      <SolidColorBrush x:Key="GapoStageStreamingBrush" Color="#B7791F" />
      <SolidColorBrush x:Key="GapoStageOtherBrush" Color="#8A909B" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1D4FD8" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1A45BD" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#1D4FD8" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#1A45BD" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="GapoBackgroundBrush" Color="#1C1D21" />
      <SolidColorBrush x:Key="GapoSurfaceBrush" Color="#25262B" />
      <SolidColorBrush x:Key="GapoBorderBrush" Color="#34363C" />
      <SolidColorBrush x:Key="GapoTextBrush" Color="#F2F3F5" />
      <SolidColorBrush x:Key="GapoTextSecondaryBrush" Color="#A8ACB5" />
      <SolidColorBrush x:Key="GapoTextTertiaryBrush" Color="#9096A1" />
      <SolidColorBrush x:Key="GapoAccentBrush" Color="#6EA8FE" />
      <SolidColorBrush x:Key="GapoOnAccentBrush" Color="#10131A" />
      <SolidColorBrush x:Key="GapoGoodBrush" Color="#4ADE80" />
      <SolidColorBrush x:Key="GapoWarnBrush" Color="#FBBF24" />
      <SolidColorBrush x:Key="GapoBadBrush" Color="#F87171" />
      <SolidColorBrush x:Key="GapoGoodTintBrush" Color="#4ADE80" Opacity="0.10" />
      <SolidColorBrush x:Key="GapoWarnTintBrush" Color="#FBBF24" Opacity="0.10" />
      <SolidColorBrush x:Key="GapoBadTintBrush" Color="#F87171" Opacity="0.10" />
      <SolidColorBrush x:Key="GapoStageSimulationBrush" Color="#E27AA8" />
      <SolidColorBrush x:Key="GapoStageRenderingBrush" Color="#5BB3E0" />
      <SolidColorBrush x:Key="GapoStagePresentBrush" Color="#A499F0" />
      <SolidColorBrush x:Key="GapoStageStreamingBrush" Color="#E6B450" />
      <SolidColorBrush x:Key="GapoStageOtherBrush" Color="#7D828D" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#6EA8FE" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#86B7FE" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#5C96EC" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#10131A" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#10131A" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#10131A" />
      <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#6EA8FE" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#86B7FE" />
      <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#5C96EC" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="GapoBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GapoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GapoBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="GapoOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="GapoGoodBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoBadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoGoodTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GapoWarnTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GapoBadTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="GapoStageSimulationBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="GapoStageRenderingBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="GapoStagePresentBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="GapoStageStreamingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="GapoStageOtherBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="GapoPagePadding">24</x:Double>
  <CornerRadius x:Key="GapoCornerRadius">8</CornerRadius>

  <Style x:Key="GapoCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GapoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource GapoBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource GapoCornerRadius}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="GapoResultNumberStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
    <Setter Property="FontSize" Value="60" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource GapoTextBrush}" />
  </Style>

  <Style x:Key="GapoTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource GapoTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="GapoBodyStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource GapoTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="GapoSecondaryStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource GapoTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="GapoSectionLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource GapoTextTertiaryBrush}" />
  </Style>

  <Style x:Key="GapoValueStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource GapoTextBrush}" />
  </Style>
</ResourceDictionary>
